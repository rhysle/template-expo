{
  "name": "template-expo",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "check": "pnpm lint && pnpm -r check:type",
    "lint": "eslint apps/*/src packages",
    "check:i18n": "pnpm -r --if-present check:i18n",
    "create:app": "node --import tsx packages/tooling/scripts/create-app.ts"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@dev-plugins/react-query": "0.4.0",
    "@expo-google-fonts/dev": "0.4.76",
    "@expo/plist": "0.8.1",
    "@tanstack/eslint-plugin-query": "5.101.4",
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "eslint": "9.39.5",
    "eslint-config-expo": "57.0.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-react-compiler": "19.1.0-rc.2",
    "eslint-plugin-simple-import-sort": "13.0.0",
    "google-auth-library": "11.0.0",
    "prettier": "3.9.6",
    "sharp": "0.34.5",
    "tsx": "4.23.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.66.0",
    "zod-validation-error": "4.0.2"
  }

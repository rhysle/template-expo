{
  "name": "@rhysle/water-eject",
  "main": "expo-router/entry",
  "version": "1.1.0",
  "scripts": {
    "start": "APP_VARIANT=development expo start",
    "start:tunnel": "APP_VARIANT=development expo start --tunnel",
    "android": "JAVA_HOME=$(/usr/libexec/java_home -v 17) expo run:android",
    "android:device": "JAVA_HOME=$(/usr/libexec/java_home -v 17) expo run:android --device",
    "ios": "expo run:ios",
    "ios:device": "expo run:ios --device",
    "web": "expo start --web",
    "prebuild": "APP_VARIANT=development expo prebuild",
    "prebuild:ios": "APP_VARIANT=development expo prebuild --platform ios",
    "prebuild:android": "APP_VARIANT=development expo prebuild --platform android",
    "prebuild:clean": "APP_VARIANT=development expo prebuild --clean",
    "prebuild:ios:clean": "APP_VARIANT=development expo prebuild --clean --platform ios",
    "prebuild:android:clean": "APP_VARIANT=development expo prebuild --clean --platform android",
    "eas-build": "node --import tsx ../../packages/tooling/scripts/eas-app.ts build --platform all --profile production",
    "eas-build:local": "pnpm eas-build:ios:local && pnpm eas-build:android:local",
    "eas-build:ios": "node --import tsx ../../packages/tooling/scripts/eas-app.ts build --platform ios --profile production",
    "eas-build:ios:submit": "node --import tsx ../../packages/tooling/scripts/eas-app.ts build --platform ios --profile production --auto-submit",
    "eas-build:ios:local": "set -a && . ./.env.local && set +a && node --import tsx ../../packages/tooling/scripts/eas-app.ts build --platform ios --profile production --local",
    "eas-build:android": "node --import tsx ../../packages/tooling/scripts/eas-app.ts build --platform android --profile production",
    "eas-build:android:submit": "node --import tsx ../../packages/tooling/scripts/eas-app.ts build --platform android --profile production --auto-submit",
    "eas-build:android:local": "set -a && . ./.env.local && set +a && JAVA_HOME=$(/usr/libexec/java_home -v 17) node --import tsx ../../packages/tooling/scripts/eas-app.ts build --platform android --profile production --local",
    "eas-build-run:ios": "eas build:run -p ios",
    "eas-build-run:android": "eas build:run -p android",
    "eas-submit:ios": "eas submit --platform ios",
    "eas-submit:android": "eas submit --platform android",
    "eas-update:android": "eas update --channel production --environment production --platform android && pnpm exec sentry-expo-upload-sourcemaps dist",
    "eas-update:ios": "eas update --channel production --environment production --platform ios && pnpm exec sentry-expo-upload-sourcemaps dist",
    "eas-update": "pnpm eas-update:ios && pnpm eas-update:android",
    "lint": "eslint src",
    "check": "pnpm lint && pnpm check:type",
    "check:type": "tsc --noEmit",
    "check:compiler": "pnpm dlx react-compiler-healthcheck@latest",
    "check:i18n": "node --import tsx ../../packages/tooling/scripts/check-i18n.ts",
    "check:i18n:fix": "node --import tsx ../../packages/tooling/scripts/check-i18n.ts --remove-unused",
    "check:i18n:release": "node --import tsx ../../packages/tooling/scripts/check-i18n.ts --release",
    "check:i18n:release:fix": "node --import tsx ../../packages/tooling/scripts/check-i18n.ts --release --remove-unused",
    "release:version": "node --import tsx ../../packages/tooling/scripts/bump-version.ts",
    "release:patch": "pnpm release:version patch",
    "release:minor": "pnpm release:version minor",
    "release:major": "pnpm release:version major",
    "release:verify-config": "APP_VARIANT=production pnpm exec expo config --type public",
    "setup:expo": "node --import tsx ../../packages/tooling/scripts/setup-expo.ts",
    "setup:firebase": "node --import tsx ../../packages/tooling/scripts/setup-firebase.ts",
    "setup:sentry": "node --import tsx ../../packages/tooling/scripts/setup-sentry.ts",
    "setup:i18n": "node --import tsx ../../packages/tooling/scripts/setup-i18n.ts",
    "setup:ads": "node --import tsx ../../packages/tooling/scripts/setup-ads.ts",
    "setup:font": "node --import tsx ../../packages/tooling/scripts/setup-font.ts",
    "monetization:plan": "node --import tsx ../../packages/tooling/scripts/monetization/index.ts plan",
    "monetization:apply": "node --import tsx ../../packages/tooling/scripts/monetization/index.ts apply",
    "monetization:verify": "node --import tsx ../../packages/tooling/scripts/monetization/index.ts verify",
    "monetization:activate": "node --import tsx ../../packages/tooling/scripts/monetization/index.ts activate",
    "monetization:prices:plan": "node --import tsx ../../packages/tooling/scripts/monetization/index.ts prices-plan",
    "monetization:prices:apply": "node --import tsx ../../packages/tooling/scripts/monetization/index.ts prices-apply",
    "monetization:prices:verify": "node --import tsx ../../packages/tooling/scripts/monetization/index.ts prices-verify",
    "monetization:ppp:refresh": "node --import tsx ../../packages/tooling/scripts/monetization/ppp-refresh.ts",
    "fastlane:ios:init": "fastlane ios init_metadata",
    "fastlane:ios:metadata": "fastlane ios metadata",
    "fastlane:ios:metadata:globals": "fastlane ios metadata globals:true",
    "fastlane:android:init": "fastlane android init_metadata",
    "fastlane:android:metadata": "fastlane android metadata",
    "fastlane:android:metadata:validate": "fastlane android metadata validate_only:true",
    "fastlane:android:changelog": "fastlane android changelog track:internal",
    "doctor": "pnpm dlx expo-doctor",
    "align-deps": "pnpm exec expo install --fix",
    "format": "prettier ./src --write --log-level error && eslint ./src --fix --quiet",
    "eas-build:inspect": "APP_VARIANT=production node --import tsx ../../packages/tooling/scripts/eas-app.ts build:inspect --platform ios --stage archive"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "0.4.2",
    "@expo/ui": "57.0.9",
    "@react-native-firebase/analytics": "24.1.1",
    "@react-native-firebase/app": "24.1.1",
    "@sentry/react-native": "7.11.0",
    "@shopify/react-native-skia": "2.7.0",
    "@tanstack/query-async-storage-persister": "5.101.4",
    "@tanstack/react-query": "5.101.4",
    "@tanstack/react-query-persist-client": "5.101.4",
    "date-fns": "4.4.0",
    "expo": "57.0.11",
    "expo-blur": "57.0.2",
    "expo-build-properties": "57.0.9",
    "expo-clipboard": "57.0.1",
    "expo-constants": "57.0.9",
    "expo-crypto": "57.0.1",
    "expo-dev-client": "57.0.10",
    "expo-device": "57.0.1",
    "expo-font": "57.0.1",
    "expo-haptics": "57.0.1",
    "expo-image": "57.0.2",
    "expo-linear-gradient": "57.0.1",
    "expo-linking": "57.0.5",
    "expo-localization": "57.0.1",
    "expo-network": "57.0.1",
    "expo-router": "57.0.11",
    "expo-splash-screen": "57.0.5",
    "expo-status-bar": "57.0.1",
    "expo-store-review": "57.0.1",
    "expo-system-ui": "57.0.2",
    "expo-tracking-transparency": "57.0.1",
    "expo-updates": "57.0.12",
    "expo-web-browser": "57.0.2",
    "i18next": "26.3.6",
    "immer": "11.1.16",
    "lottie-react-native": "7.3.8",
    "phosphor-react-native": "3.0.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "17.0.11",
    "react-native": "0.86.2",
    "react-native-audio-api": "0.13.2",
    "react-native-gesture-handler": "2.32.0",
    "react-native-google-mobile-ads": "16.3.4",
    "react-native-mmkv": "4.3.2",
    "react-native-nitro-modules": "0.35.10",
    "react-native-purchases": "10.4.2",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.2",
    "react-native-svg": "15.15.4",
    "react-native-volume-manager": "2.0.8",
    "react-native-web": "0.21.2",
    "react-native-worklets": "0.10.1",
    "zustand": "5.0.14",
    "@rhysle/mobile-foundation": "workspace:*",
    "@rhysle/ads": "workspace:*"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@dev-plugins/react-query": "0.4.0",
    "@expo-google-fonts/dev": "0.4.76",
    "@expo/plist": "0.8.1",
    "@tanstack/eslint-plugin-query": "5.101.4",
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "eslint": "9.39.5",
    "eslint-config-expo": "57.0.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-react-compiler": "19.1.0-rc.2",
    "eslint-plugin-simple-import-sort": "13.0.0",
    "google-auth-library": "11.0.0",
    "prettier": "3.9.6",
    "tsx": "4.23.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.66.0",
    "zod-validation-error": "4.0.2",
    "@rhysle/tooling": "workspace:*"
  },
  "private": true,
  "expo": {
    "autolinking": {
      "ios": {
        "exclude": []
      },
      "android": {
        "exclude": []
      }
    },
    "install": {
      "exclude": [
        "@shopify/react-native-skia"
      ]
    }
  }
}

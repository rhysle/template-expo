{
  "expo": {
    "name": "Starter",
    "slug": "starter",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icons/ios-icon.png",
    "scheme": "starter",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": {
        "light": "./assets/icons/ios-icon.png",
        "dark": "./assets/icons/ios-icon.png",
        "tinted": "./assets/icons/ios-icon-tinted.png"
      },
      "supportsTablet": true,
      "bundleIdentifier": "com.rhysle.starter",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "allowBackup": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icons/android-icon-adaptive.png",
        "backgroundColor": "#F7FBFF"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.rhysle.starter",
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icons/splash-icon.png",
          "imageWidth": 100,
          "resizeMode": "contain",
          "backgroundColor": "#F7FBFF"
        }
      ],
      [
        "expo-localization",
        {
          "supportsRTL": true,
          "supportedLocales": [
            "ar",
            "bn",
            "ca",
            "cs",
            "da",
            "de",
            "el",
            "en",
            "es",
            "es-MX",
            "fi",
            "fr",
            "fr-CA",
            "he",
            "hi",
            "hr",
            "hu",
            "id",
            "it",
            "ja",
            "ko",
            "ms",
            "nb",
            "nl",
            "pl",
            "pt",
            "pt-BR",
            "ro",
            "ru",
            "sk",
            "sv",
            "th",
            "tr",
            "uk",
            "vi",
            "zh-Hans",
            "zh-Hant"
          ]
        }
      ],
      [
        "expo-font",
        {
          "ios": {
            "fonts": [
              "../../node_modules/@expo-google-fonts/inter/300Light/Inter_300Light.ttf",
              "../../node_modules/@expo-google-fonts/inter/400Regular/Inter_400Regular.ttf",
              "../../node_modules/@expo-google-fonts/inter/500Medium/Inter_500Medium.ttf",
              "../../node_modules/@expo-google-fonts/inter/600SemiBold/Inter_600SemiBold.ttf",
              "../../node_modules/@expo-google-fonts/inter/700Bold/Inter_700Bold.ttf"
            ]
          },
          "android": {
            "fonts": [
              {
                "fontFamily": "Inter",
                "fontDefinitions": [
                  {
                    "path": "../../node_modules/@expo-google-fonts/inter/300Light/Inter_300Light.ttf",
                    "weight": 300
                  },
                  {
                    "path": "../../node_modules/@expo-google-fonts/inter/400Regular/Inter_400Regular.ttf",
                    "weight": 400
                  },
                  {
                    "path": "../../node_modules/@expo-google-fonts/inter/500Medium/Inter_500Medium.ttf",
                    "weight": 500
                  },
                  {
                    "path": "../../node_modules/@expo-google-fonts/inter/600SemiBold/Inter_600SemiBold.ttf",
                    "weight": 600
                  },
                  {
                    "path": "../../node_modules/@expo-google-fonts/inter/700Bold/Inter_700Bold.ttf",
                    "weight": 700
                  }
                ]
              }
            ]
          }
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "extraProguardRules": "-keep class com.google.android.gms.internal.consent_sdk.** { *; }"
          },
          "ios": {
            "useFrameworks": "static",
            "forceStaticLinking": [
              "RNFBApp",
              "RNFBAnalytics"
            ]
          }
        }
      ],
      "expo-updates",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser",
      "@react-native-firebase/app",
      "@rhysle/tooling/plugins/withRNFirebaseStaticFramework.js"
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {}
    }
  }
}

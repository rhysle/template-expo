{
  "expo": {
    "name": "DualZen",
    "slug": "dualzen",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icons/ios-icon.png",
    "scheme": "dualzen",
    "userInterfaceStyle": "dark",
    "ios": {
      "icon": {
        "light": "./assets/icons/ios-icon.png",
        "dark": "./assets/icons/ios-icon.png",
        "tinted": "./assets/icons/ios-icon-tinted.png"
      },
      "supportsTablet": false,
      "bundleIdentifier": "com.rhysle.dualzen",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "DualZen uses the camera to take photos and record videos in portrait and landscape together.",
        "NSMicrophoneUsageDescription": "DualZen records synchronized audio for your videos.",
        "NSPhotoLibraryAddUsageDescription": "Save copies of your DualZen photos and videos to Photos."
      }
    },
    "android": {
      "allowBackup": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icons/android-icon-adaptive.png",
        "backgroundColor": "#242424"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.rhysle.dualzen",
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-sharing",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icons/splash-icon.png",
          "imageWidth": 100,
          "resizeMode": "contain",
          "backgroundColor": "#090B10"
        }
      ],
      [
        "expo-localization",
        {
          "supportsRTL": true,
          "supportedLocales": [
            "ar",
            "bn",
            "ca",
            "cs",
            "da",
            "de",
            "el",
            "en",
            "es",
            "es-MX",
            "fi",
            "fr",
            "fr-CA",
            "he",
            "hi",
            "hr",
            "hu",
            "id",
            "it",
            "ja",
            "ko",
            "ms",
            "nb",
            "nl",
            "pl",
            "pt",
            "pt-BR",
            "ro",
            "ru",
            "sk",
            "sv",
            "th",
            "tr",
            "uk",
            "vi",
            "zh-Hans",
            "zh-Hant"
          ]
        }
      ],
      [
        "expo-font",
        {
          "ios": {
            "fonts": [
              "../../node_modules/@expo-google-fonts/lexend/300Light/Lexend_300Light.ttf",
              "../../node_modules/@expo-google-fonts/lexend/400Regular/Lexend_400Regular.ttf",
              "../../node_modules/@expo-google-fonts/lexend/500Medium/Lexend_500Medium.ttf",
              "../../node_modules/@expo-google-fonts/lexend/600SemiBold/Lexend_600SemiBold.ttf",
              "../../node_modules/@expo-google-fonts/lexend/700Bold/Lexend_700Bold.ttf"
            ]
          },
          "android": {
            "fonts": [
              {
                "fontFamily": "Lexend",
                "fontDefinitions": [
                  {
                    "path": "../../node_modules/@expo-google-fonts/lexend/300Light/Lexend_300Light.ttf",
                    "weight": 300
                  },
                  {
                    "path": "../../node_modules/@expo-google-fonts/lexend/400Regular/Lexend_400Regular.ttf",
                    "weight": 400
                  },
                  {
                    "path": "../../node_modules/@expo-google-fonts/lexend/500Medium/Lexend_500Medium.ttf",
                    "weight": 500
                  },
                  {
                    "path": "../../node_modules/@expo-google-fonts/lexend/600SemiBold/Lexend_600SemiBold.ttf",
                    "weight": 600
                  },
                  {
                    "path": "../../node_modules/@expo-google-fonts/lexend/700Bold/Lexend_700Bold.ttf",
                    "weight": 700
                  }
                ]
              }
            ]
          }
        }
      ],
      [
        "@shared/tooling/plugins/withSegmentedControlFont.js",
        {
          "postScriptName": "Lexend-Regular"
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "project": "dualzen",
          "organization": "rhysle"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "extraProguardRules": "-keep class com.google.android.gms.internal.consent_sdk.** { *; }",
            "minSdkVersion": 29
          },
          "ios": {
            "useFrameworks": "static",
            "forceStaticLinking": [
              "RNFBApp",
              "RNFBAnalytics"
            ],
            "enableSceneSupport": true
          }
        }
      ],
      "expo-updates",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser",
      "@react-native-firebase/app",
      "@shared/tooling/plugins/withRNFirebaseStaticFramework.js",
      "expo-video",
      [
        "expo-screen-orientation",
        {
          "initialOrientation": "DEFAULT"
        }
      ]
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c1d6d208-8446-46ae-a625-1f9a8776d42c"
      }
    },
    "owner": "rhysle",
    "updates": {
      "url": "https://u.expo.dev/c1d6d208-8446-46ae-a625-1f9a8776d42c"
    },
    "platforms": [
      "ios",
      "android"
    ]
  }
}

# Fastlane credentials template
# Copy this file to .env.fastlane.local (gitignored) and fill in the values.
# Fastfile auto-loads .env.fastlane.local at startup.
# App name, iOS bundle ID, and Android package name are read from app.json.

# --- iOS: App Store Connect API key ---
# Create in App Store Connect → Users and Access → Keys (App Manager role).
# Download the .p8 file ONCE; drop it under fastlane/.private/.
APP_STORE_CONNECT_API_KEY_KEY_ID=
APP_STORE_CONNECT_API_KEY_ISSUER_ID=
APP_STORE_CONNECT_API_KEY_KEY_FILEPATH=./fastlane/.private/AuthKey_XXXXXXXX.p8

# --- iOS: App Review attachment ---
# Fastlane replaces the App Review attachment during every metadata upload.
# Keep the product-specific recording local; fastlane/ios/review/ is gitignored.
IOS_APP_REVIEW_ATTACHMENT_PATH=./fastlane/ios/review/recording.mp4

# Optional — only needed if you fall back to Apple ID auth instead of the API key
# APPLE_ID=
# APPLE_TEAM_ID=
# ITC_TEAM_ID=

# --- Android: Google Play service account JSON ---
# Create in Google Cloud Console → IAM → Service accounts, then invite into
# Play Console → Users and permissions with product/subscription permissions.
GOOGLE_PLAY_JSON_KEY_PATH=./fastlane/.private/play-service-account.json

# --- RevenueCat: project configuration API v2 ---
# The iOS and Android RevenueCat app records must already exist. They are found
# by matching app.json identifiers. Use a secret V2 key with app read access and
# read/write access to products, entitlements, offerings, and packages.
REVENUECAT_PROJECT_ID=
REVENUECAT_API_V2_KEY=

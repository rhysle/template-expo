# Reusable Sentry Internal Integration token for all apps' setup:sentry commands.
# Copy this file to root .env.setup.local. Never commit that local file or add it to EAS.
# Requires Organization Read, Team Admin, and Project Read & Write.
# Source-map uploads use the separate SENTRY_AUTH_TOKEN in each app's build environment.
SENTRY_SETUP_AUTH_TOKEN=
